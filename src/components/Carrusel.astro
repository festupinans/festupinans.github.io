---
// StackCarrusel.astro – Carrusel reutilizable, recibe elementos por prop
import TechTag from './TechTag.astro';

export interface Props {
  items: string[];
  tagClass?: string;
  ariaLabel?: string;
  size?: "sm" | "md" | "lg";
}
const { items, tagClass, ariaLabel = "Carrusel de elementos", size = "lg" } = Astro.props;
let isAnimating = items.length > 4; // Solo animar si hay mas de 4 elementos
---
{/* Carrusel de tecnologías, con scroll infinito y pausa al hover */
isAnimating && (
<div class={'tech-carousel-wrapper' + size} aria-label={ariaLabel}>
  <div class="tech-carousel" tabindex="0">
    <div class="carousel-track">
      {items.map(tag => (
        <TechTag name={tag} size={size} class={tagClass} />
      ))}
    </div>
    <!-- Duplicamos el track para crear la ilusión de scroll infinito sin cortes -->
    <div class="carousel-track" aria-hidden="true">
      {items.map(tag => (
        <TechTag name={tag} size={size} class={tagClass} />
      ))}
    </div>
  </div>
</div>

) || (
  <div class="static-tech-list" aria-label={ariaLabel}>
    {items.map(tag => (
      <TechTag name={tag} size={size} class={tagClass} />
    ))}
  </div>
)
}

<style>
  /* Estilos para cuando hay 4 o menos elementos (ESTÁTICO) */
.static-tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
}
.tech-carousel-wrapperlg {
    width: 100%; max-width: 650px; margin: 0 auto 2.5rem;
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
}
.tech-carousel-wrappersm {
    width: 100%; max-width: 650px; margin: 0 auto 2.5rem;
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
}
.tech-carousel-wrappermd{
 width: 100%; max-width: 650px; margin: 0;
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
}
.tech-carousel { 
    display: flex;
    width: 100%; 
    cursor: grab; 
    user-select: none; 
    outline: none; 
    margin-top: .5rem;
    margin-bottom: .5rem;
}
.tech-carousel:hover .carousel-track{
    animation-play-state: paused;
}
.carousel-track {
    display: flex; 
    gap: 0.75rem; 
    padding-right: 0.75rem; /* Esencial para mantener el espacio exacto entre los dos tracks */
    justify-content: flex-start;
    align-items: center;
    flex-shrink: 0;
    min-width: 100%;
    width: max-content;
    will-change: transform;
    animation: scroll-carousel 75s linear infinite; /* Controla la velocidad aquí (mayor s = más lento) */
}
@keyframes scroll-carousel {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
}
@media (max-width: 768px) {
    .tech-carousel-wrapper { max-width: 95vw; }
}
</style>
