---
// Educacion.astro - Timeline de formación académica con glassmorphism

// Estructura de datos para educación
const educacion = [
    {
        institucion: "Universidad Nacional de Colombia",
        titulo: "Diseñador Industrial",
        tipo: "Pregrado",
        periodo: "Ene. 2017 - Dic. 2023",
        descripcion:
            "Formación integral en diseño de productos, experiencia de usuario, y desarrollo de soluciones innovadoras centradas en el ser humano.",
        logros: ["Proyecto de grado destacado", "Énfasis en diseño digital"],
    },
    {
        institucion: "Universidad El Bosque",
        titulo: "Desarrollo de Software",
        tipo: "Diplomado",
        periodo: "Ene. 2022 - Nov. 2022",
        descripcion:
            "Formación en arquitectura de software, patrones de diseño, y metodologías ágiles para el desarrollo de aplicaciones.",
        logros: ["Desarrollo Full Stack", "Metodologías Ágiles"],
    },
    {
        institucion: "Universidad El Bosque",
        titulo: "Fundamentos de Programación",
        tipo: "Diplomado",
        periodo: "Ene. 2022 - Nov. 2022",
        descripcion:
            "Bases sólidas en lógica de programación, estructuras de datos y algoritmos fundamentales.",
        logros: ["Algoritmos", "Estructuras de Datos"],
    },
    {
        institucion: "Universidad El Bosque",
        titulo: "Programación Básica",
        tipo: "Diplomado",
        periodo: "Ene. 2022 - Nov. 2022",
        descripcion:
            "Introducción al mundo de la programación con énfasis en pensamiento computacional y resolución de problemas.",
        logros: ["Python", "JavaScript"],
    },
];
---

<section id="educacion" class="section">
    <div class="glass-wrapper">
        <div class="container">
            <h2 class="section-title">
                <span class="title-accent">//</span> Educación
            </h2>

            <div class="timeline">
                {
                    educacion.map((edu) => (
                        <div class="timeline-item">
                            <div class="timeline-marker" />
                            <div class="timeline-content">
                                <div class="edu-header">
                                    <div class="edu-title-group">
                                        <h3 class="edu-titulo">{edu.titulo}</h3>
                                        <span class="edu-tipo">{edu.tipo}</span>
                                    </div>
                                    <span class="edu-periodo">
                                        {edu.periodo}
                                    </span>
                                </div>
                                <h4 class="edu-institucion">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="16"
                                        height="16"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                        <polyline points="9 22 9 12 15 12 15 22" />
                                    </svg>
                                    {edu.institucion}
                                </h4>
                                {edu.descripcion && (
                                    <p class="edu-descripcion">
                                        {edu.descripcion}
                                    </p>
                                )}
                                {edu.logros && edu.logros.length > 0 && (
                                    <div class="edu-logros">
                                        {edu.logros.map((logro) => (
                                            <span class="logro-tag">
                                                {logro}
                                            </span>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 6rem 2rem;
        position: relative;
        z-index: 1;
    }

    .glass-wrapper {
        backdrop-filter: blur(13px);
        -webkit-backdrop-filter: blur(13px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 3rem;
        box-shadow:
            0 8px 32px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);
        max-width: 1100px;
        width: 100%;
    }

    .container {
        width: 100%;
    }

    .section-title {
        font-size: clamp(2rem, 5vw, 3rem);
        color: #ffffff;
        margin-bottom: 3rem;
        font-weight: 700;
    }

    .title-accent {
        color: #ff3914;
    }

    .timeline {
        position: relative;
        padding-left: 2rem;
    }

    .timeline::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(to bottom, #ff3914, rgba(255, 57, 20, 0.1));
    }

    .timeline-item {
        position: relative;
        padding-bottom: 2.5rem;
    }

    .timeline-item:last-child {
        padding-bottom: 0;
    }

    .timeline-marker {
        position: absolute;
        left: -2rem;
        top: 0;
        width: 14px;
        height: 14px;
        background: #ff3914;
        border-radius: 50%;
        transform: translateX(-6px);
        box-shadow: 0 0 20px rgba(255, 57, 20, 0.6);
    }

    .timeline-content {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 1.5rem 2rem;
        transition: all 0.3s ease;
    }

    .timeline-content:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 57, 20, 0.4);
        transform: translateX(10px);
    }

    .edu-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .edu-title-group {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .edu-titulo {
        font-size: 1.3rem;
        color: #ffffff;
        margin: 0;
        font-weight: 600;
    }

    .edu-tipo {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.9);
        font-weight: 500;
        padding: 0.25rem 0.6rem;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .edu-periodo {
        font-size: 0.85rem;
        color: #ff3914;
        font-weight: 500;
        padding: 0.3rem 0.8rem;
        background: rgba(255, 57, 20, 0.15);
        border-radius: 20px;
        white-space: nowrap;
    }

    .edu-institucion {
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.7);
        margin: 0 0 1rem;
        font-weight: 400;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .edu-institucion svg {
        opacity: 0.6;
        flex-shrink: 0;
    }

    .edu-descripcion {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.6);
        line-height: 1.7;
        margin: 0 0 1rem;
    }

    .edu-logros {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .logro-tag {
        font-size: 0.8rem;
        padding: 0.35rem 0.9rem;
        background: rgba(255, 57, 20, 0.1);
        border: 1px solid rgba(255, 57, 20, 0.25);
        border-radius: 15px;
        color: #ff3914;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .section {
            padding: 5rem 1rem;
        }

        .glass-wrapper {
            padding: 2rem 1.5rem;
        }

        .timeline {
            padding-left: 2rem;
        }

        .timeline-marker {
            left: -2rem;
            width: 24px;
            height: 24px;
            transform: translateX(-11px);
        }

        .timeline-marker svg {
            width: 12px;
            height: 12px;
        }

        .timeline-content {
            padding: 1.25rem 1.5rem;
        }

        .edu-header {
            flex-direction: column;
            gap: 0.5rem;
        }

        .edu-title-group {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .edu-titulo {
            font-size: 1.15rem;
        }
    }
</style>
