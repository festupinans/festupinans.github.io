---
// Experiencia.astro - Timeline de experiencia laboral con glassmorphism
import TechTag from './TechTag.astro';
import EmpresaButton from './EmpresaButton.astro';
import Carrusel from './Carrusel.astro';
import { experiencias } from '../data/experiencias';
---

<section id="experiencia" class="section">
    <div class="glass-wrapper">
        <div class="container">
            <h2 class="section-title">
                <span class="title-accent">//</span> Experiencia
            </h2>

            <div class="timeline">
                {
                    experiencias.map((exp, index) => (
                        <div class="timeline-item">
                            <div class="timeline-marker" />
                            <div class="timeline-content">
                                <div class="exp-header">
                                    <h3 class="exp-cargo">{exp.cargo}</h3>
                                    <span class="exp-periodo">
                                        {exp.periodo}
                                    </span>
                                </div>
                                <div class="exp-empresa-wrapper">
                                    <EmpresaButton empresa={exp.empresa} />
                                </div>
                                <p class="exp-descripcion">{exp.descripcion}</p>
                                <div class="exp-techs">
                                    <Carrusel items={exp.tecnologias} size="md" />
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 6rem 2rem;
        position: relative;
        z-index: 1;
    }

    .glass-wrapper {
        /* background: rgba(10, 10, 20, 0.7); */
        backdrop-filter: blur(13px);
        -webkit-backdrop-filter: blur(13px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 3rem;
        box-shadow:
            0 8px 32px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);
        max-width: 1100px;
        width: 100%;
    }

    .container {
        width: 100%;
    }

    .section-title {
        font-size: clamp(2rem, 5vw, 3rem);
        color: #ffffff;
        margin-bottom: 3rem;
        font-weight: 700;
    }

    .title-accent {
        color: #ff3914;
    }

    .timeline {
        position: relative;
        padding-left: 2rem;
    }

    .timeline::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(to bottom, #ff3914, rgba(255, 57, 20, 0.1));
    }

    .timeline-item {
        position: relative;
        padding-bottom: 2.5rem;
    }

    .timeline-item:last-child {
        padding-bottom: 0;
    }

    .timeline-marker {
        position: absolute;
        left: -2rem;
        top: 0;
        width: 14px;
        height: 14px;
        background: #ff3914;
        border-radius: 50%;
        transform: translateX(-6px);
        box-shadow: 0 0 20px rgba(255, 57, 20, 0.6);
    }

    .timeline-content {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 1.5rem 2rem;
        transition: all 0.3s ease;
    }

    .timeline-content:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 57, 20, 0.4);
        transform: translateX(10px);
    }

    .exp-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .exp-cargo {
        font-size: 1.3rem;
        color: #ffffff;
        margin: 0;
        font-weight: 600;
    }

    .exp-periodo {
        font-size: 0.85rem;
        color: #ff3914;
        font-weight: 500;
        padding: 0.3rem 0.8rem;
        background: rgba(255, 57, 20, 0.15);
        border-radius: 20px;
        white-space: nowrap;
    }

    .exp-empresa-wrapper {
        margin-bottom: 0.5rem;
    }

    .exp-descripcion {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.6);
        line-height: 1.7;
        margin: 0 0 1rem;
    }

    .exp-techs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .section {
            padding: 5rem 1rem;
        }

        .glass-wrapper {
            padding: 2rem 1.5rem;
        }

        .timeline {
            padding-left: 1.5rem;
        }

        .timeline-marker {
            left: -1.5rem;
            width: 12px;
            height: 12px;
            transform: translateX(-5px);
        }

        .timeline-content {
            padding: 1.25rem 1.5rem;
        }

        .exp-header {
            flex-direction: column;
            gap: 0.5rem;
        }

        .exp-cargo {
            font-size: 1.15rem;
        }
    }
</style>
