---
// Proyectos.astro - Grid de proyectos destacados con glassmorphism
import TechTag from "./TechTag.astro";
import { TECNOLOGIAS } from "../data/tecnologias";
import type { Empresa } from "../data/empresas";
import { proyectos, type Proyecto } from "../data/proyectos";
import Carrusel from "./Carrusel.astro";
import EmpresaButton from "./EmpresaButton.astro";
import QRCode from "qrcode";

// Pre-generar los códigos QR para los proyectos de RA
const qrCodes = await Promise.all(
  proyectos.map(async (p) => {
    if (p.esWebAR && p.enlaceAR) {
      try {
        return await QRCode.toDataURL(p.enlaceAR, {
          width: 300,
          margin: 2,
          color: {
            dark: "#000000ff",
            light: "#ffffffff",
          },
        });
      } catch (err) {
        console.error("Error generando QR", err);
        return null;
      }
    }
    return null;
  })
);
---

<section id="proyectos" class="section">
  <div class="glass-wrapper">
    <div class="container">
      <h2 class="section-title">
        <span class="title-accent">//</span> Proyectos
      </h2>

      <div class="projects-grid">
        {
          proyectos.map(
            (proyecto: Proyecto, index: number) => (
              <article
                class="project-card project-card-clickable"
                data-target={`project-modal-${index}`}
              >
                <div class="project-image">
                  <img
                    src={proyecto.imagen}
                    alt={`Imagen del proyecto ${proyecto.titulo}`}
                    class="project-image-img"
                    loading="lazy"
                  />
                  <div class="project-overlay">
                    <span class="view-more-text">{proyecto.esWebAR ? 'Ver RA' : 'Ver más'}</span>
                    <div class="project-links">
                      {proyecto.github && (
                        <a
                          href={proyecto.github}
                          class="project-link"
                          target="_blank"
                          rel="noopener"
                          title="Ver código"
                          onclick="event.stopPropagation()"
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                          >
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                          </svg>
                        </a>
                      )}
                      {proyecto.demo && (
                        <a
                          href={proyecto.demo}
                          class="project-link"
                          target="_blank"
                          rel="noopener"
                          title="Ver demo"
                          onclick="event.stopPropagation()"
                        >
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                            <polyline points="15 3 21 3 21 9" />
                            <line x1="10" y1="14" x2="21" y2="3" />
                          </svg>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
                <div class="project-content">
                  <h3 class="project-title">{proyecto.titulo}</h3>
                  {proyecto.empresa && (
                    <EmpresaButton empresa={proyecto.empresa} />
                  )}
                  <p class="project-description">{proyecto.descripcion}</p>
                  <div class="project-techs">
                    {proyecto.tecnologias.length > 4 ? (
                      <Carrusel items={proyecto.tecnologias} size="sm" tagClass="tech-tag-card" ariaLabel={`Tecnologías del proyecto ${proyecto.titulo}`} />
                    ) : (
                      proyecto.tecnologias.map(
                        (
                          tech: (typeof TECNOLOGIAS)[keyof typeof TECNOLOGIAS],
                        ) => (
                          <TechTag name={tech} size="sm" />
                        ),
                      )
                    )}
                  </div>
                </div>
              </article>
            ),
          )
        }
      </div>

      <!-- Modales (renderizados fuera del grid para no romper layout y scopes) -->
      {
        proyectos.map(
          (proyecto: Proyecto, index: number) => (
            <dialog id={`project-modal-${index}`} class={`project-modal ${proyecto.esWebAR ? 'ar-modal' : ''}`}>
              <div class="modal-glass">
                <button class="close-modal-btn" aria-label="Cerrar modal">
                  &times;
                </button>

                <div class="modal-standard-view">
                  <div class="modal-left">
                    <h3 class="modal-title">{proyecto.titulo}</h3>
                    {proyecto.empresa && (
                      <EmpresaButton empresa={proyecto.empresa} />
                    )}
                    <p class="modal-description">{proyecto.descripcion}</p>
                    <p class="modal-extended-description">
                      {proyecto.descripcionExtensa}
                    </p>
                    <div class="modal-techs">
                      {proyecto.tecnologias.length > 4 ? (
                        <Carrusel items={proyecto.tecnologias} size="sm" tagClass="tech-tag-modal" ariaLabel={`Tecnologías del proyecto ${proyecto.titulo}`} />
                      ) : (
                        proyecto.tecnologias.map(
                          (
                            tech: (typeof TECNOLOGIAS)[keyof typeof TECNOLOGIAS],
                          ) => (
                            <TechTag name={tech} size="sm" />
                          ),
                        )
                      )}
                    </div>
                    <div class="modal-actions">
                      {proyecto.esWebAR && (
                        <button class="btn btn-primary show-ar-btn">
                          Ver RA
                        </button>
                      )}
                      {proyecto.github && (
                        <a
                          href={proyecto.github}
                          class="btn btn-outline"
                          target="_blank"
                          rel="noopener"
                        >
                          Ver Repositorio
                        </a>
                      )}
                      {proyecto.demo && (
                        <a
                          href={proyecto.demo}
                          class="btn btn-primary"
                          target="_blank"
                          rel="noopener"
                        >
                          Ver Demo
                        </a>
                      )}
                    </div>
                  </div>
                  <div class="modal-right">
                    <div
                      class="carousel-container"
                      data-carousel={`carousel-${index}`}
                    >
                      <div class="carousel-track">
                        {proyecto.imagenes?.map((img: string, i: number) => (
                          <div
                            class={`carousel-slide ${i === 0 ? "active" : ""}`}
                            data-index={i}
                          >
                            <img
                              src={img}
                              alt={`Imagen del proyecto ${proyecto.titulo} - ${i + 1}`}
                              class="carousel-image zoomable-img"
                              loading="lazy"
                            />
                          </div>
                        ))}
                      </div>
                      {(proyecto.imagenes?.length || 0) > 1 &&
                        proyecto.imagenes && (
                          <>
                            <button
                              class="carousel-btn prev"
                              aria-label="Imagen anterior"
                            >
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              >
                                <polyline points="15 18 9 12 15 6" />
                              </svg>
                            </button>
                            <button
                              class="carousel-btn next"
                              aria-label="Siguiente imagen"
                            >
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              >
                                <polyline points="9 18 15 12 9 6" />
                              </svg>
                            </button>
                            <div class="carousel-dots">
                              {proyecto.imagenes.map((_: string, i: number) => (
                                <button
                                  class={`carousel-dot ${i === 0 ? "active" : ""}`}
                                  aria-label={`Ir a imagen ${i + 1}`}
                                  data-target={i}
                                />
                              ))}
                            </div>
                          </>
                        )}
                    </div>
                  </div>
                </div>

                {proyecto.esWebAR && (
                  <div class="ar-container" style="display: none;">
                    <button class="btn btn-outline back-to-info-btn">
                      &larr; Volver a la información
                    </button>
                    <h3 class="ar-title">Escanea para vivir la experiencia RA</h3>
                    <p class="ar-subtitle">Sigue estos pasos desde tu celular:</p>
                    
                    <div class="ar-content-wrapper">
                      <div class="ar-qr-section">
                        <span class="ar-step-number">1</span>
                        <p class="ar-step-text">Abre la cámara de tu celular y escanea este código QR</p>
                        <div class="ar-qr-box">
                          {qrCodes[index] && <img src={qrCodes[index]} alt={`QR code para ${proyecto.titulo}`} class="ar-qr-img zoomable-img" />}
                        </div>
                      </div>

                      {proyecto.marcadorAR && (
                        <>
                          <div class="ar-divider"></div>
                          <div class="ar-marker-section">
                            <span class="ar-step-number">2</span>
                            <p class="ar-step-text">Apunta tu cámara a esta imagen para ver la magia</p>
                            <div class="ar-marker-box">
                              <img src={proyecto.marcadorAR} alt={`Marcador para ${proyecto.titulo}`} class="ar-marker-img zoomable-img" />
                            </div>
                          </div>
                        </>
                      )}
                    </div>
                  </div>
                )}
              </div>
            </dialog>
          ),
        )
      }
      <!-- Lightbox para hacer zoom a las imágenes -->
      <dialog id="image-lightbox" class="lightbox-modal">
        <button class="close-lightbox-btn" aria-label="Cerrar imagen">&times;</button>
        <img id="lightbox-img" src="" alt="Imagen ampliada" class="lightbox-img" />
      </dialog>
    </div>
  </div>
</section>

<style>
  .section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 2rem;
    position: relative;
    z-index: 1;
  }

  .glass-wrapper {
    /* background: rgba(10, 10, 20, 0.7); */
    backdrop-filter: blur(13px);
    -webkit-backdrop-filter: blur(13px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 3rem;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    max-width: 1100px;
    width: 100%;
  }

  .container {
    width: 100%;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: #ffffff;
    margin-bottom: 3rem;
    font-weight: 700;
  }

  .title-accent {
    color: #ff3914;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .project-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  .project-card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 57, 20, 0.5);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .project-image {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .project-image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .project-card:hover .project-image-img {
    transform: scale(1.05);
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .project-links {
    display: flex;
    gap: 1rem;
  }

  .project-link {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: all 0.3s ease;
  }

  .project-link:hover {
    background: #ff3914;
    border-color: #ff3914;
    transform: scale(1.15);
  }

  .project-content {
    padding: 1.5rem;
  }

  .project-title {
    font-size: 1.2rem;
    color: #ffffff;
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  .project-description {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .project-techs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .section {
      padding: 5rem 1rem;
    }

    .glass-wrapper {
      padding: 2rem 1.5rem;
    }

    .project-content {
      padding: 1.25rem;
    }
  }

  /* Modal Styles */
  .modal-standard-view {
    display: flex;
    width: 100%;
  }

  .zoomable-img {
    cursor: zoom-in;
    transition: transform 0.3s ease;
  }
  
  .zoomable-img:hover {
    transform: scale(1.05);
  }

  /* Lightbox Styles */
  .lightbox-modal {
    background: transparent;
    border: none;
    padding: 0;
    max-width: 100vw;
    max-height: 100vh;
    margin: auto;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-modal:not([open]) {
    display: none;
  }

  .lightbox-modal::backdrop {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(5px);
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
  }

  .close-lightbox-btn {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
  }

  .close-lightbox-btn:hover {
    background: #ff3914;
    border-color: #ff3914;
    transform: scale(1.1);
  }

  .project-card-clickable {
    cursor: pointer;
  }

  .project-overlay {
    flex-direction: column;
    gap: 1rem;
  }

  .view-more-text {
    color: #fff;
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 1px;
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.3s ease;
  }

  .project-card:hover .view-more-text {
    transform: translateY(0);
    opacity: 1;
  }

  .project-modal {
    background: transparent;
    border: none;
    padding: 0;
    max-width: 1400px;
    width: 95%;
    margin: auto;
    max-height: 95vh;
  }

  .project-modal::backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .modal-glass {
    background: rgba(15, 15, 25, 0.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    display: flex;
    overflow: hidden;
    position: relative;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    color: white;
    max-height: 95vh;
  }

  .close-modal-btn {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
  }

  .close-modal-btn:hover {
    background: #ff3914;
    border-color: #ff3914;
    transform: scale(1.1);
  }

  .modal-left {
    flex: 1;
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow-y: auto;
  }

  .modal-title {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 1rem;
    color: #fff;
  }

  .modal-description {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .modal-extended-description {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .modal-techs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    width: 100%;
  }
  
  :global(.tech-tag-modal),
  :global(.tech-tag-card) {
    flex-shrink: 0;
  }

  .modal-actions {
    display: flex;
    gap: 1rem;
    margin-top: auto;
  }

  /* AR Modal Styles */
  .ar-container {
    padding: 3rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow-y: auto;
  }

  .ar-title {
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: #fff;
  }

  .ar-subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 2.5rem;
  }

  .ar-content-wrapper {
    display: flex;
    gap: 3rem;
    align-items: stretch;
    justify-content: center;
    width: 100%;
    max-width: 900px;
  }

  .ar-qr-section,
  .ar-marker-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(255, 255, 255, 0.03);
    padding: 2rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: transform 0.3s ease;
  }

  .ar-qr-section:hover,
  .ar-marker-section:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 57, 20, 0.3);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .ar-divider {
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.2), transparent);
    margin: 2rem 0;
  }

  .ar-step-number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ff3914;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1.1rem;
    margin-bottom: 1rem;
    box-shadow: 0 0 15px rgba(255, 57, 20, 0.5);
  }

  .ar-step-text {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 1.5rem;
    min-height: 3rem;
  }

  .ar-qr-box,
  .ar-marker-box {
    background: white;
    padding: 1rem;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 250px;
    aspect-ratio: 1 / 1;
  }

  .ar-qr-img,
  .ar-marker-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 4px;
  }

  .btn {
    padding: 0.8rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .btn-primary {
    background: #ff3914;
    color: white;
    border: 1px solid #ff3914;
  }

  .btn-primary:hover {
    background: #ff5733;
    box-shadow: 0 4px 15px rgba(255, 57, 20, 0.4);
  }

  .btn-outline {
    background: transparent;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: white;
  }

  .modal-right {
    flex: 1.5;
    background: rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
  }

  .carousel-container {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-track {
    display: grid;
    width: 100%;
  }

  .carousel-slide {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    pointer-events: none;
  }

  .carousel-slide.active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }

  .carousel-image {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(15, 15, 25, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
    backdrop-filter: blur(4px);
  }

  .carousel-btn:hover {
    background: #ff3914;
    border-color: #ff3914;
    transform: translateY(-50%) scale(1.1);
  }

  .carousel-btn.prev {
    left: 1rem;
  }

  .carousel-btn.next {
    right: 1rem;
  }

  .carousel-dots {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 10;
    background: rgba(0, 0, 0, 0.4);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    backdrop-filter: blur(4px);
  }

  .carousel-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .carousel-dot:hover {
    background: rgba(255, 255, 255, 0.8);
  }

  .carousel-dot.active {
    background: #ff3914;
    transform: scale(1.2);
  }

  @media (max-width: 900px) {
    .modal-standard-view {
      flex-direction: column-reverse;
      min-height: auto;
      overflow-y: auto;
    }
    .ar-content-wrapper {
      flex-direction: column;
      gap: 1.5rem;
    }
    .ar-divider {
      width: 100%;
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.2), transparent);
      margin: 1rem 0;
    }
    .ar-container {
      padding: 2rem 1rem;
    }
    .ar-title {
      font-size: 1.8rem;
    }
    .modal-right {
      border-left: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      min-height: auto;
      flex: none;
      height: auto;
    }
    .carousel-slide {
      padding: 1rem;
    }
    .carousel-image {
      max-height: 50vh;
    }
    .modal-left {
      padding: 2rem;
      overflow-y: visible;
    }
    .modal-title {
      font-size: 1.8rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const projectCards = document.querySelectorAll(".project-card-clickable");
    const closeBtns = document.querySelectorAll(".close-modal-btn");

    projectCards.forEach((card) => {
      card.addEventListener("click", () => {
        const targetId = card.getAttribute("data-target");
        if (targetId) {
          const modal = document.getElementById(targetId) as HTMLDialogElement;
          if (modal) {
            modal.showModal();
            document.body.style.overflow = "hidden"; // Prevent scrolling
          }
        }
      });
    });

    closeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const modal = btn.closest("dialog");
        if (modal) {
          modal.close();
          document.body.style.overflow = "";
          const standardView = modal.querySelector('.modal-standard-view');
          const arView = modal.querySelector('.ar-container');
          if (standardView && arView) {
            (standardView as HTMLElement).style.display = 'flex';
            (arView as HTMLElement).style.display = 'none';
          }
        }
      });
    });

    // Initialize carousels
    const carousels = document.querySelectorAll(".carousel-container");
    carousels.forEach((carousel) => {
      const slides = carousel.querySelectorAll(".carousel-slide");
      const dots = carousel.querySelectorAll(".carousel-dot");
      const nextBtn = carousel.querySelector(".next");
      const prevBtn = carousel.querySelector(".prev");

      if (slides.length <= 1) return; // No need for carousel logic if 1 or 0 images

      let currentIndex = 0;

      // Initialize first slide as active
      slides[currentIndex].classList.add("active");

      const goToSlide = (index: number) => {
        slides.forEach((slide) => slide.classList.remove("active"));
        dots.forEach((dot) => dot.classList.remove("active"));

        slides[index].classList.add("active");
        if (dots[index]) dots[index].classList.add("active");
        currentIndex = index;
      };

      const nextSlide = () => {
        let newIndex = currentIndex + 1;
        if (newIndex >= slides.length) newIndex = 0;
        goToSlide(newIndex);
      };

      const prevSlide = () => {
        let newIndex = currentIndex - 1;
        if (newIndex < 0) newIndex = slides.length - 1;
        goToSlide(newIndex);
      };

      if (nextBtn) nextBtn.addEventListener("click", nextSlide);
      if (prevBtn) prevBtn.addEventListener("click", prevSlide);

      dots.forEach((dot, index) => {
        dot.addEventListener("click", () => goToSlide(index));
      });
    });
    // Close on backdrop click
    const dialogs = document.querySelectorAll(".project-modal");
    dialogs.forEach((dialog) => {
      dialog.addEventListener("click", (e: Event) => {
        const mouseEvent = e as MouseEvent;
        const dialogElement = dialog as HTMLDialogElement;
        
        // Dont trigger close if clicking inside standard or AR views
        const standardView = dialog.querySelector('.modal-standard-view');
        const arView = dialog.querySelector('.ar-container');
        
        const rect = dialogElement.getBoundingClientRect();
        const isInDialog =
          rect.top <= mouseEvent.clientY &&
          mouseEvent.clientY <= rect.top + rect.height &&
          rect.left <= mouseEvent.clientX &&
          mouseEvent.clientX <= rect.left + rect.width;
          
        if (!isInDialog) {
          dialogElement.close();
          document.body.style.overflow = "";
          // reset view state
          if (standardView && arView) {
            (standardView as HTMLElement).style.display = 'flex';
            (arView as HTMLElement).style.display = 'none';
          }
        }
      });
    });

    // AR views toggle logic
    const showArBtns = document.querySelectorAll(".show-ar-btn");
    const backInfoBtns = document.querySelectorAll(".back-to-info-btn");

    showArBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const modal = btn.closest(".project-modal");
        if (modal) {
          const standardView = modal.querySelector(".modal-standard-view") as HTMLElement;
          const arView = modal.querySelector(".ar-container") as HTMLElement;
          if (standardView && arView) {
            standardView.style.display = "none";
            arView.style.display = "flex";
          }
        }
      });
    });

    backInfoBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const modal = btn.closest(".project-modal");
        if (modal) {
          const standardView = modal.querySelector(".modal-standard-view") as HTMLElement;
          const arView = modal.querySelector(".ar-container") as HTMLElement;
          if (standardView && arView) {
            arView.style.display = "none";
            standardView.style.display = "flex";
          }
        }
      });
    });

    // Image lightbox logic
    const zoomableImgs = document.querySelectorAll(".zoomable-img");
    const lightbox = document.getElementById("image-lightbox") as HTMLDialogElement;
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
    const closeLightboxBtn = document.querySelector(".close-lightbox-btn");

    if (lightbox && lightboxImg && closeLightboxBtn) {
      zoomableImgs.forEach((img) => {
        img.addEventListener("click", () => {
          lightboxImg.src = (img as HTMLImageElement).src;
          lightbox.showModal();
        });
      });

      closeLightboxBtn.addEventListener("click", () => {
        lightbox.close();
      });

      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) {
          lightbox.close();
        }
      });
    }
  });
</script>
