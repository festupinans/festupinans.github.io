---
// ServicioModal.astro - Modal individual por servicio
import TechTag from "./TechTag.astro";

interface Props {
    servicio: {
        id: string;
        titulo: string;
        descripcionCorta: string;
        icono: string;
        tecnologias: readonly string[];
        plataformas: readonly string[];
        descripcionExtensa: string;
        proceso: readonly string[];
        queNecesito: readonly string[];
    };
    index: number;
}

const { servicio, index } = Astro.props;
const modalId = `servicio-modal-${index}`;
---

<dialog id={modalId} class="servicio-modal">
    <div class="modal-glass">
        <button class="close-modal-btn" aria-label="Cerrar modal">
            &times;
        </button>

        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-icono">
                    <span class="icono-texto">{servicio.icono}</span>
                </div>
                <div>
                    <h3 class="modal-titulo">{servicio.titulo}</h3>
                    <div class="modal-plataformas">
                        {servicio.plataformas.map((p) => (
                            <span class="plataforma-tag">{p}</span>
                        ))}
                    </div>
                </div>
            </div>

            <p class="modal-descripcion">{servicio.descripcionExtensa}</p>

            <div class="modal-seccion">
                <h4 class="modal-seccion-titulo">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 11 12 14 22 4"></polyline>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                    </svg>
                    Proceso de trabajo
                </h4>
                <ol class="proceso-lista">
                    {servicio.proceso.map((paso) => (
                        <li class="proceso-item">{paso}</li>
                    ))}
                </ol>
            </div>

            <div class="modal-seccion">
                <h4 class="modal-seccion-titulo">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Qué necesito de tu parte
                </h4>
                <ul class="necesito-lista">
                    {servicio.queNecesito.map((item) => (
                        <li class="necesito-item">{item}</li>
                    ))}
                </ul>
            </div>

            <div class="modal-techs">
                <span class="modal-techs-label">Tecnologías:</span>
                <div class="modal-techs-tags">
                    {servicio.tecnologias.map((tech) => (
                        <TechTag name={tech} size="sm" />
                    ))}
                </div>
            </div>

            <div class="modal-actions">
                <button
                    class="btn btn-primary contact-service-btn"
                    data-service={servicio.id}
                    data-service-name={servicio.titulo}
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Trabajar conmigo en esto
                </button>
                <button class="btn btn-outline close-modal-btn-2">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</dialog>

<style>
    .servicio-modal {
        background: transparent;
        border: none;
        padding: 0;
        max-width: 700px;
        width: 95%;
        max-height: 80vh;
    }

    .servicio-modal:not([open]) {
        display: none;
    }

    .servicio-modal::backdrop {
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .servicio-modal[open] {
        display: flex;
        align-items: center;
        justify-content: center;
        position: fixed;
        inset: 0;
        margin: auto;
    }

    .modal-glass {
        background: rgba(15, 15, 25, 0.97);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 24px;
        padding: 2.5rem;
        color: white;
        max-height: 78vh;
        overflow-y: auto;
        position: relative;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6);
        width: 100%;
    }

    .modal-glass::-webkit-scrollbar {
        width: 6px;
    }

    .modal-glass::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 3px;
    }

    .modal-glass::-webkit-scrollbar-thumb {
        background: rgba(255, 57, 20, 0.4);
        border-radius: 3px;
    }

    .close-modal-btn {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: rgba(255, 255, 255, 0.7);
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        cursor: pointer;
        transition: all 0.3s ease;
        line-height: 1;
        z-index: 10;
    }

    .close-modal-btn:hover {
        background: #ff3914;
        border-color: #ff3914;
        color: white;
        transform: scale(1.1);
    }

    .modal-content {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-right: 1rem;
    }

    .modal-header {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .modal-icono {
        width: 56px;
        height: 56px;
        background: linear-gradient(135deg, rgba(255, 57, 20, 0.25), rgba(255, 107, 74, 0.1));
        border: 1px solid rgba(255, 57, 20, 0.35);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .modal-icono .icono-texto {
        font-size: 0.75rem;
    }

    .modal-titulo {
        font-size: 1.6rem;
        color: #ffffff;
        margin: 0 0 0.5rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .modal-plataformas {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .plataforma-tag {
        font-size: 0.65rem;
        color: rgba(255, 255, 255, 0.5);
        padding: 0.2rem 0.5rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .modal-descripcion {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.75);
        line-height: 1.75;
        margin: 0;
    }

    .modal-seccion {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
    }

    .modal-seccion-titulo {
        font-size: 0.9rem;
        color: #ff3914;
        margin: 0 0 1rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .proceso-lista {
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: proceso-counter;
    }

    .proceso-item {
        counter-increment: proceso-counter;
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.7);
        padding: 0.5rem 0;
        padding-left: 2rem;
        position: relative;
        line-height: 1.5;
    }

    .proceso-item + .proceso-item {
        border-top: 1px solid rgba(255, 255, 255, 0.04);
    }

    .proceso-item::before {
        content: counter(proceso-counter);
        position: absolute;
        left: 0;
        top: 0.5rem;
        width: 1.25rem;
        height: 1.25rem;
        background: rgba(255, 57, 20, 0.15);
        border: 1px solid rgba(255, 57, 20, 0.3);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        color: #ff3914;
        font-weight: 600;
    }

    .necesito-lista {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .necesito-item {
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.7);
        padding-left: 1.5rem;
        position: relative;
        line-height: 1.5;
    }

    .necesito-item::before {
        content: "→";
        position: absolute;
        left: 0;
        color: #ff3914;
    }

    .modal-techs {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .modal-techs-label {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.5);
    }

    .modal-techs-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .modal-actions {
        display: flex;
        gap: 1rem;
        margin-top: 0.5rem;
        flex-wrap: wrap;
    }

    .btn {
        padding: 0.85rem 1.75rem;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.95rem;
        cursor: pointer;
    }

    .btn-primary {
        background: linear-gradient(135deg, #ff3914, #ff6b4a);
        color: #fff;
        border: none;
        box-shadow: 0 4px 20px rgba(255, 57, 20, 0.4);
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 30px rgba(255, 57, 20, 0.5);
    }

    .btn-outline {
        background: transparent;
        color: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .btn-outline:hover {
        border-color: rgba(255, 255, 255, 0.5);
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
    }

    @media (max-width: 600px) {
        .modal-glass {
            padding: 2rem 1.5rem;
            max-height: 80vh;
        }

        .modal-titulo {
            font-size: 1.4rem;
        }

        .modal-icono {
            width: 48px;
            height: 48px;
        }

        .modal-content {
            padding-right: 0;
        }
    }
</style>