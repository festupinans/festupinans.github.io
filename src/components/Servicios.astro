---

<section id="servicios" class="section">
    <div class="glass-wrapper">
        <div class="container">
            <h2 class="section-title">
                <span class="title-accent">//</span> Servicios
            </h2>

            <div class="servicios-grid">
                {
                    servicios.map((servicio, index) => (
                        <article
                            class="servicio-card"
                            data-target={`servicio-modal-${index}`}
                        >
                            <div class="servicio-icono">
                                <span class="icono-texto">{servicio.icono}</span>
                            </div>
                            <h3 class="servicio-titulo">{servicio.titulo}</h3>
                            <p class="servicio-descripcion">{servicio.descripcionCorta}</p>
                            <div class="servicio-techs">
                                {
                                    servicio.tecnologias.slice(0, 3).map((tech) => (
                                        <TechTag name={tech} size="sm" />
                                    ))
                                }
                                {servicio.tecnologias.length > 3 && (
                                    <span class="tech-more">+{servicio.tecnologias.length - 3}</span>
                                )}
                            </div>
                            <div class="servicio-plataformas">
                                {servicio.plataformas.map((plataforma) => (
                                    <span class="plataforma-tag">{plataforma}</span>
                                ))}
                            </div>
                            <div class="card-cta">
                                <span>Ver detalles</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<!-- Modales separados en su propio componente -->
{servicios.map((servicio, index) => (
    <ServicioModal servicio={servicio} index={index} />
))}

<style>
    .section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 6rem 2rem;
        position: relative;
        z-index: 1;
    }

    .glass-wrapper {
        backdrop-filter: blur(13px);
        -webkit-backdrop-filter: blur(13px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 3rem;
        box-shadow:
            0 8px 32px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);
        max-width: 1100px;
        width: 100%;
    }

    .container {
        width: 100%;
    }

    .section-title {
        font-size: clamp(2rem, 5vw, 3rem);
        color: #ffffff;
        margin-bottom: 3rem;
        font-weight: 700;
    }

    .title-accent {
        color: #ff3914;
    }

    .servicios-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .servicio-card {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 1.75rem;
        transition: all 0.35s ease;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

    .servicio-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #ff3914, transparent);
        opacity: 0;
        transition: opacity 0.35s ease;
    }

    .servicio-card:hover {
        transform: translateY(-8px);
        border-color: rgba(255, 57, 20, 0.5);
        box-shadow:
            0 24px 48px rgba(0, 0, 0, 0.35),
            0 0 0 1px rgba(255, 57, 20, 0.1);
        background: rgba(255, 255, 255, 0.06);
    }

    .servicio-card:hover::before {
        opacity: 1;
    }

    .servicio-icono {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, rgba(255, 57, 20, 0.2), rgba(255, 107, 74, 0.08));
        border: 1px solid rgba(255, 57, 20, 0.3);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all 0.35s ease;
    }

    .servicio-card:hover .servicio-icono {
        background: linear-gradient(135deg, rgba(255, 57, 20, 0.35), rgba(255, 107, 74, 0.15));
        transform: scale(1.05);
    }

    .icono-texto {
        font-size: 0.65rem;
        font-weight: 700;
        color: #ff3914;
        letter-spacing: 1px;
    }

    .servicio-titulo {
        font-size: 1.1rem;
        color: #ffffff;
        margin: 0;
        font-weight: 600;
        line-height: 1.3;
    }

    .servicio-descripcion {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.55);
        line-height: 1.6;
        margin: 0;
        flex-grow: 1;
    }

    .servicio-techs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
    }

    .tech-more {
        font-size: 0.7rem;
        color: rgba(255, 255, 255, 0.4);
        padding: 0.15rem 0.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 4px;
    }

    .servicio-plataformas {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .plataforma-tag {
        font-size: 0.6rem;
        color: rgba(255, 255, 255, 0.45);
        padding: 0.15rem 0.45rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .card-cta {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        color: #ff3914;
        font-size: 0.8rem;
        font-weight: 500;
        margin-top: auto;
        padding-top: 0.5rem;
        transition: gap 0.3s ease;
    }

    .servicio-card:hover .card-cta {
        gap: 0.7rem;
    }

    @media (max-width: 1024px) {
        .servicios-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 700px) {
        .section {
            padding: 5rem 1rem;
        }

        .glass-wrapper {
            padding: 2rem 1.5rem;
        }

        .servicios-grid {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }

        .servicio-card {
            padding: 1.5rem;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const cards = document.querySelectorAll(".servicio-card");
        const closeBtns = document.querySelectorAll(".close-modal-btn, .close-modal-btn-2");
        const contactBtns = document.querySelectorAll(".contact-service-btn");

        // Open modal
        cards.forEach((card) => {
            card.addEventListener("click", () => {
                const targetId = card.getAttribute("data-target");
                if (targetId) {
                    const modal = document.getElementById(targetId) as HTMLDialogElement;
                    if (modal) {
                        modal.showModal();
                        document.body.style.overflow = "hidden";
                    }
                }
            });
        });

        // Close modal
        const closeModal = (dialog: HTMLDialogElement) => {
            dialog.close();
            document.body.style.overflow = "";
        };

        closeBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const modal = btn.closest("dialog");
                if (modal) closeModal(modal as HTMLDialogElement);
            });
        });

        // Close on backdrop click
        document.querySelectorAll(".servicio-modal").forEach((dialog) => {
            dialog.addEventListener("click", (e: Event) => {
                const rect = (dialog as HTMLDialogElement).getBoundingClientRect();
                const mouseEvent = e as MouseEvent;
                const isInDialog =
                    rect.top <= mouseEvent.clientY &&
                    mouseEvent.clientY <= rect.top + rect.height &&
                    rect.left <= mouseEvent.clientX &&
                    mouseEvent.clientX <= rect.left + rect.width;

                if (!isInDialog) {
                    (dialog as HTMLDialogElement).close();
                    document.body.style.overflow = "";
                }
            });
        });

        // Contact button: prefill form and scroll
        contactBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                const serviceId = btn.getAttribute("data-service");
                const serviceName = btn.getAttribute("data-service-name");

                console.log("[Servicios] Contact btn clicked, serviceId:", serviceId, "serviceName:", serviceName);
                sessionStorage.setItem("selectedService", serviceId || "");
                sessionStorage.setItem("selectedServiceName", serviceName || "");
                console.log("[Servicios] sessionStorage set:", sessionStorage.getItem("selectedService"));

                const modal = btn.closest("dialog");
                if (modal) closeModal(modal as HTMLDialogElement);

                const contactSection = document.getElementById("contacto");
                if (contactSection) {
                    contactSection.scrollIntoView({ behavior: "smooth" });
                }
            });
        });
    });
</script>