<script>
    import * as THREE from "three";
    import gsap from "gsap";
    import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";
    import { MeshSurfaceSampler } from "three/examples/jsm/math/MeshSurfaceSampler.js";
    import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
    import { EffectComposer } from "three/examples/jsm/postprocessing/EffectComposer.js";
    import { RenderPass } from "three/examples/jsm/postprocessing/RenderPass.js";
    import { UnrealBloomPass } from "three/examples/jsm/postprocessing/UnrealBloomPass.js";

    // --- Configuration ---
    const PARTICLE_COUNT = 500;
    const PARTICLE_SIZE1 = 0.08;
    const PARTICLE_SIZE2 = 0.06;
    const COLORS = [0xffffff, 0xff00ff, 0xff3914]; // Base colors

    // --- Scene Setup ---
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
        75,
        window.innerWidth / window.innerHeight,
        0.1,
        1000,
    );
    camera.position.z = 6;

    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Post-processing: Bloom
    const composer = new EffectComposer(renderer);
    const renderPass = new RenderPass(scene, camera);
    composer.addPass(renderPass);

    const bloomPass = new UnrealBloomPass(
        new THREE.Vector2(window.innerWidth, window.innerHeight),
        1.2,  // strength — higher for Points since they rely on emissive
        0.4,  // radius
        0.6   // threshold — lower so the dimmer white particles also bloom
    );
    composer.addPass(bloomPass);

    const ambientLight = new THREE.AmbientLight(0xffffff, 1);
    scene.add(ambientLight);

    // OrbitControls
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.enableZoom = true;
    controls.autoRotate = false;

    const container = document.getElementById("webgl");
    if (container) {
        container.appendChild(renderer.domElement);
    }

    // --- Groups for Rotation ---
    const mainGroup = new THREE.Group();
    scene.add(mainGroup);

    const group1 = new THREE.Group();
    const group2 = new THREE.Group();
    mainGroup.add(group1);
    mainGroup.add(group2);

    // --- Geometries for sampling ---
    const geometries = [
        new THREE.SphereGeometry(3, 32, 16),
        new THREE.TorusKnotGeometry(1.5, 0.4, 100, 16),
        new THREE.TetrahedronGeometry(3),
        new THREE.OctahedronGeometry(3),
        new THREE.IcosahedronGeometry(3),
        new THREE.DodecahedronGeometry(3),
        new THREE.CylinderGeometry(3, 1, 2, 32),
        new THREE.ConeGeometry(3, 2, 32),
        new THREE.CapsuleGeometry(2.5, 2.5, 4, 8),
        new THREE.BoxGeometry(3.5, 3.5, 3.5),
    ];

    // --- Create circular particle texture ---
    function createParticleTexture() {
        const canvas = document.createElement("canvas");
        canvas.width = 64;
        canvas.height = 64;
        const ctx = canvas.getContext("2d")!;

        // Radial gradient: bright center, soft edge
        const gradient = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
        gradient.addColorStop(0, "rgba(255, 255, 255, 1)");
        gradient.addColorStop(0.3, "rgba(255, 255, 255, 0.9)");
        gradient.addColorStop(0.7, "rgba(255, 255, 255, 0.4)");
        gradient.addColorStop(1, "rgba(255, 255, 255, 0)");

        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, 64, 64);

        const texture = new THREE.CanvasTexture(canvas);
        return texture;
    }

    const particleTexture = createParticleTexture();

    function sampleGeometry(
        geometry: THREE.BufferGeometry,
        count: number,
    ): Float32Array {
        let mesh;
        if (geometry instanceof THREE.BufferGeometry) {
            mesh = new THREE.Mesh(geometry, new THREE.MeshBasicMaterial());
        } else {
            return new Float32Array(count * 3);
        }

        const sampler = new MeshSurfaceSampler(mesh).build();
        const particles = new Float32Array(count * 3);
        const tempPosition = new THREE.Vector3();

        for (let i = 0; i < count; i++) {
            sampler.sample(tempPosition);
            particles[i * 3] = tempPosition.x;
            particles[i * 3 + 1] = tempPosition.y;
            particles[i * 3 + 2] = tempPosition.z;
        }

        return particles;
    }

    // Load external models and add as shape targets
    function loadModel(url: string) {
        const loader = new GLTFLoader();
        loader.load(url, (gltf) => {
            gltf.scene.traverse((child) => {
                if ((child as THREE.Mesh).isMesh) {
                    const mesh = child as THREE.Mesh;
                    [particles1, particles2].forEach((p) => {
                        if (p && p.userData && p.userData.targets) {
                            const count = p.geometry.attributes.position.count;
                            const sampled = sampleGeometry(mesh.geometry, count);
                            p.userData.targets.push(sampled);
                        }
                    });
                }
            });
        });
    }

    loadModel("/models/Susan.glb");

    // --- Particle System with Points (BufferGeometry) ---
    function createParticleSystem(
        group: THREE.Group,
        count: number,
        color: number,
        size: number,
    ) {
        // BufferGeometry with positions
        const geometry = new THREE.BufferGeometry();
        const positions = new Float32Array(count * 3);

        // Initial sampling
        const initialPositions = sampleGeometry(geometries[0], count);
        positions.set(initialPositions);
        geometry.setAttribute(
            "position",
            new THREE.BufferAttribute(positions, 3),
        );

        // PointsMaterial with texture + bloom
        const material = new THREE.PointsMaterial({
            color: color,
            size: size,
            map: particleTexture,
            transparent: true,
            opacity: 0.95,
            sizeAttenuation: true,
            alphaTest: 0.01,
            depthWrite: false,
        });

        const points = new THREE.Points(geometry, material);
        points.frustumCulled = true;

        // Store targets and state
        const targets = geometries.map((geo) => sampleGeometry(geo, count));
        const posAttr = geometry.attributes.position;

        points.userData = {
            targets: targets,
            currentShape: 0,
            positions: initialPositions,
            posAttr: posAttr,
        };

        group.add(points);
        return points;
    }

    const particles1 = createParticleSystem(
        group1,
        PARTICLE_COUNT,
        COLORS[2],
        PARTICLE_SIZE1,
    );
    const particles2 = createParticleSystem(
        group2,
        Math.floor(PARTICLE_COUNT / 2),
        COLORS[0],
        PARTICLE_SIZE2,
    );

    // --- State & Animation Logic ---
    let rotSpeed = 0.002;
    let isStable = true;
    let currentShapeIndex = 0;

    // --- Interaction ---
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    function onMouseMove(event: MouseEvent) {
        mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
        mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
    }

    // --- Explode & Reassemble ---
    function explodeAndReassemble() {
        isStable = false;

        const totalShapes = particles1.userData.targets.length;
        currentShapeIndex = (currentShapeIndex + 1) % totalShapes;

        [particles1, particles2].forEach((p) => {
            const posAttr = p.userData.posAttr;
            const count = posAttr.count;
            const currentPositions = p.userData.positions;
            const startPositions = Float32Array.from(currentPositions);

            // Scatter destinations
            const scatterPositions = new Float32Array(currentPositions.length);
            for (let i = 0; i < currentPositions.length; i += 3) {
                const dir = new THREE.Vector3(
                    startPositions[i],
                    startPositions[i + 1],
                    startPositions[i + 2],
                )
                    .normalize()
                    .multiplyScalar(5 + Math.random() * 5);

                scatterPositions[i] = dir.x;
                scatterPositions[i + 1] = dir.y;
                scatterPositions[i + 2] = dir.z;
            }

            // Phase 1: Explosion
            const obj = { t: 0 };
            gsap.to(obj, {
                t: 1,
                duration: 0.8,
                ease: "expo.out",
                onUpdate: () => {
                    for (let i = 0; i < count; i++) {
                        const i3 = i * 3;
                        const x =
                            startPositions[i3] +
                            (scatterPositions[i3] - startPositions[i3]) * obj.t;
                        const y =
                            startPositions[i3 + 1] +
                            (scatterPositions[i3 + 1] - startPositions[i3 + 1]) * obj.t;
                        const z =
                            startPositions[i3 + 2] +
                            (scatterPositions[i3 + 2] - startPositions[i3 + 2]) * obj.t;

                        posAttr.setXYZ(i, x, y, z);
                        currentPositions[i3] = x;
                        currentPositions[i3 + 1] = y;
                        currentPositions[i3 + 2] = z;
                    }
                    posAttr.needsUpdate = true;
                },
                onComplete: () => {
                    const targetPositions = p.userData.targets[currentShapeIndex];
                    const scatteredPositions = Float32Array.from(currentPositions);

                    // Phase 2: Reassembly
                    isStable = true;
                    const obj2 = { t: 0 };
                    gsap.to(obj2, {
                        t: 1,
                        duration: 1.2,
                        ease: "elastic.out(1, 0.3)",
                        onUpdate: () => {
                            for (let i = 0; i < count; i++) {
                                const i3 = i * 3;
                                const x =
                                    scatteredPositions[i3] +
                                    (targetPositions[i3] - scatteredPositions[i3]) * obj2.t;
                                const y =
                                    scatteredPositions[i3 + 1] +
                                    (targetPositions[i3 + 1] - scatteredPositions[i3 + 1]) * obj2.t;
                                const z =
                                    scatteredPositions[i3 + 2] +
                                    (targetPositions[i3 + 2] - scatteredPositions[i3 + 2]) * obj2.t;

                                posAttr.setXYZ(i, x, y, z);
                                currentPositions[i3] = x;
                                currentPositions[i3 + 1] = y;
                                currentPositions[i3 + 2] = z;
                            }
                            posAttr.needsUpdate = true;
                        },
                    });
                },
            });
        });
    }

    function onClick() {
        if (!isStable) return;
        explodeAndReassemble();
    }

    window.addEventListener("mousemove", onMouseMove);
    window.addEventListener("click", onClick);
    window.addEventListener("touchstart", onClick);
    window.addEventListener("resize", () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
        composer.setSize(window.innerWidth, window.innerHeight);
    });

    // --- Animation Loop ---
    const clock = new THREE.Clock();

    function animate() {
        // 1. Group Rotation
        group1.rotation.y += rotSpeed;
        group1.rotation.z += rotSpeed * 0.5;
        group2.rotation.y -= rotSpeed * 1.5;
        group2.rotation.z -= rotSpeed * 0.2;

        // 2. Repulsion on mouse hover (only when stable)
        if (isStable) {
            raycaster.setFromCamera(mouse, camera);

            [particles1, particles2].forEach((p) => {
                const positions = p.userData.positions;
                const posAttr = p.userData.posAttr;
                const count = posAttr.count;

                // Inverse matrix to transform ray to local space
                const inverseMatrix = new THREE.Matrix4()
                    .copy(p.matrixWorld)
                    .invert();
                const localRay = new THREE.Ray()
                    .copy(raycaster.ray)
                    .applyMatrix4(inverseMatrix);

                const repulsionRadius = 0.5;
                const repulsionForce = 0.6;

                for (let i = 0; i < count; i++) {
                    const i3 = i * 3;
                    const ox = positions[i3];
                    const oy = positions[i3 + 1];
                    const oz = positions[i3 + 2];

                    const pPos = new THREE.Vector3(ox, oy, oz);
                    const distSq = localRay.distanceSqToPoint(pPos);

                    let x = ox, y = oy, z = oz;

                    if (distSq < repulsionRadius * repulsionRadius) {
                        const closestPoint = new THREE.Vector3();
                        localRay.closestPointToPoint(pPos, closestPoint);

                        const dir = new THREE.Vector3().subVectors(pPos, closestPoint);
                        const dist = dir.length();

                        if (dist > 0.0001) {
                            const strength =
                                (1 - dist / repulsionRadius) * repulsionForce;
                            dir.normalize().multiplyScalar(strength);
                            x += dir.x;
                            y += dir.y;
                            z += dir.z;
                        }
                    }

                    posAttr.setXYZ(i, x, y, z);
                    positions[i3] = x;
                    positions[i3 + 1] = y;
                    positions[i3 + 2] = z;
                }
                posAttr.needsUpdate = true;
            });

            // Mouse tilt on main group
            mainGroup.rotation.x += (mouse.y * 0.5 - mainGroup.rotation.x) * 0.05;
            mainGroup.rotation.y += (mouse.x * 0.5 - mainGroup.rotation.y) * 0.05;
        }

        controls.update();
        composer.render();
    }

    renderer.setAnimationLoop(animate);
</script>

<div id="webgl"></div>

<style>
    #webgl {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: radial-gradient(circle at center, #1a1a2e 0%, #000000 100%);
        z-index: -10;
    }
</style>