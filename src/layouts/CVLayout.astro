---
// CVLayout.astro — Minimal dark navbar for the CV page
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" href="/Img/Favicon.webp" />
        <link rel="apple-touch-icon" href="/Img/Favicon.webp" />
        <meta name="generator" content={Astro.generator} />

        <!-- Primary SEO -->
        <meta name="author" content="Francisco Eduardo Estupiñan Sanchez" />
        <meta name="robots" content="index, follow" />
        <meta name="keywords" content="Francisco Estupiñán, Francisco Eduardo Estupiñan Sanchez, CV, Hoja de vida, Desarrollador XR, XR Developer, VR, AR, Unity, Three.js, Portfolio, Desarrollador Web, Full Stack, Colombia" />
        <link rel="canonical" href="https://pachodev.netlify.app/cv" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://pachodev.netlify.app/cv" />
        <meta property="og:title" content="CV - Francisco Estupiñán | Desarrollador XR" />
        <meta property="og:description" content="Hoja de vida de Francisco Eduardo Estupiñan Sanchez — Desarrollador XR especializado en Realidades Extendidas, WebGL, Unity y experiencias 3D de alto rendimiento." />
        <meta property="og:image" content="https://pachodev.netlify.app/Img/Favicon.webp" />
        <meta property="og:image:width" content="512" />
        <meta property="og:image:height" content="512" />
        <meta property="og:locale" content="es_CO" />
        <meta property="og:site_name" content="Francisco Estupiñán - Portfolio" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content="CV - Francisco Estupiñán | Desarrollador XR" />
        <meta name="twitter:description" content="Hoja de vida de Francisco Eduardo Estupiñan Sanchez — Desarrollador XR especializado en Realidades Extendidas, WebGL, Unity y experiencias 3D de alto rendimiento." />
        <meta name="twitter:image" content="https://pachodev.netlify.app/Img/Favicon.webp" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />

        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-4HW8D4ZK64"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'G-4HW8D4ZK64');
        </script>

        <!-- Structured Data (JSON-LD) -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Person",
                "name": "Francisco Eduardo Estupiñan Sanchez",
                "alternateName": ["Francisco Estupiñán", "Pacho Dev"],
                "url": "https://pachodev.netlify.app/cv",
                "jobTitle": "Desarrollador XR · Desarrollador Web Full Stack",
                "description": "Especialista en diseño y desarrollo de soluciones multiplataforma (Web, Mobile, Desktop) con enfoque en Realidades Extendidas (VR, AR, MR) y creación de Metaversos. Experto en Unity/C#, Three.js, WebGL/WebGPU para experiencias 3D de alto rendimiento.",
                "sameAs": [
                    "https://www.linkedin.com/in/festupinans",
                    "https://github.com/festupinans"
                ]
            }
        </script>

        <title>CV - Francisco Estupiñán | Desarrollador XR</title>
        <script>
            document.getElementById("download-cv-btn")?.addEventListener("click", () => {
                window.print();
            });
        </script>
    </head>
    <body>
        <header id="cv-navbar">
            <nav>
                <div class="nav-brand">
                    <a href="/" class="brand-link">Pacho Dev</a>
                </div>
                <ul class="nav-menu">
                    <li>
                        <a href="/" class="nav-link">Portafolio</a>
                    </li>
                    <li>
                        <a href="/cv" class="nav-link active">CV</a>
                    </li>
                </ul>
                <button class="download-btn" id="download-cv-btn" title="Descargar CV">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    Descargar
                </button>
            </nav>
        </header>
        <main>
            <slot />
        </main>
    </body>
</html>

<style is:global>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100%;
        font-family:
            "Inter",
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
        background: #fff;
        color: #111;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    main {
        position: relative;
    }

    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #f0f0f0;
    }

    ::-webkit-scrollbar-thumb {
        background: #ff3914;
        border-radius: 4px;
    }

    ::selection {
        background: rgba(255, 57, 20, 0.2);
        color: #111;
    }
</style>

<style>
    header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 60px;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 100;
        background: #000;
        border-bottom: 2px solid #ff3914;
    }

    nav {
        width: 100%;
        max-width: 900px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 2rem;
    }

    .nav-brand {
        display: block;
    }

    .brand-link {
        color: #ff3914;
        text-decoration: none;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .nav-menu {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: row;
        gap: 0.5rem;
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .nav-link {
        color: rgba(255, 255, 255, 0.6);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .nav-link:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.1);
    }

    .nav-link.active {
        color: #ff3914;
        background: rgba(255, 57, 20, 0.1);
    }

    .download-btn {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-left: 1rem;
        padding: 0.4rem 0.9rem;
        background: #ff3914;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        font-family: inherit;
    }

    .download-btn:hover {
        background: #e0320e;
    }

    /* ── Print styles ── */
    @page {
        size: letter;
        margin: 0.25in;
    }

    @media print {
        *,
        *::before,
        *::after {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }

        html, body {
            width: auto;
            background: #fff !important;
            color: #111 !important;
        }

        header {
            display: none !important;
        }
    }
</style>
